require 'fileutils'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
use_modular_headers!
prepare_react_native_project!

# If you are using a `react-native-flipper` your iOS build will fail when `NO_FLIPPER=1` is set.
# because `react-native-flipper` depends on (FlipperKit,...) that will be excluded
#
# To fix this you can also exclude `react-native-flipper` using a `react-native.config.js`
# ```js
# module.exports = {
#   dependencies: {
#     ...(process.env.NO_FLIPPER ? { 'react-native-flipper': { platforms: { ios: null } } } : {}),
# ```
flipper_config = ENV['NO_FLIPPER'] == "1" ? FlipperConfiguration.disabled : FlipperConfiguration.enabled

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'MackRunApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # Enables Flipper.
    #
    # Note that if you have use_frameworks! enabled, Flipper will not work and
    # you should disable the next line.
    :flipper_configuration => flipper_config,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'MackRunAppTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # gRPC-Core (pulled in by react-native-firebase) uses `template`-disambiguator
    # syntax that newer Clang (Xcode 16+) treats as an error instead of a warning.
    # Downgrade it back to a warning so the build can proceed.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        other_cpp_flags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || ['$(inherited)']
        other_cpp_flags = [other_cpp_flags] if other_cpp_flags.is_a?(String)
        other_cpp_flags << '-Wno-error=missing-template-arg-list-after-template-kw'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = other_cpp_flags
      end
    end

    # RNFBFirestore/FirebaseFirestoreInternal's podspec links FirebaseFirestoreInternal
    # as a -weak_framework, but this project builds pods as static libraries (no
    # use_frameworks!), so it only ever exists as libFirebaseFirestoreInternal.a,
    # never as a .framework bundle. It's already linked correctly via the plain
    # -l flag CocoaPods also emits, so the framework flag just fails the link with
    # "framework not found". Strip it from the generated aggregate xcconfig files
    # directly (plain text edit, not project-file surgery).
    Dir.glob((installer.sandbox.target_support_files_root + 'Pods-*/*.xcconfig').to_s).each do |path|
      content = File.read(path)
      stripped = content.gsub(/ -weak_framework "FirebaseFirestoreInternal"/, '')
      File.write(path, stripped) if stripped != content
    end

    # BoringSSL-GRPC's podspec injects a malformed per-file compiler flag
    # (-GCC_WARN_INHIBIT_ALL_WARNINGS) that current Clang rejects outright.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        next unless file.settings && file.settings['COMPILER_FLAGS']
        flags = file.settings['COMPILER_FLAGS'].split
        flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
        file.settings['COMPILER_FLAGS'] = flags.join(' ')
      end
    end
  end
end
